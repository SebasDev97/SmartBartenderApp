# Install:
#   sudo cp bartender.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bartender
#   journalctl -u bartender -f
#
# Note on User=: driving a WS2812 strip through rpi_ws281x needs root. If you have no
# strip (led.type: none in config.yaml), change this to User=pi.
[Unit]
Description=Smart Bartender machine service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/SmartBartender/pi
ExecStart=/home/pi/SmartBartender/pi/.venv/bin/python -m app.main --gpio --config config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

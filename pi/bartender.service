# Install:
#   sudo cp bartender.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bartender
#   journalctl -u bartender -f
#
# User= needs read/write on the Arduino's serial port: on Raspberry Pi OS the default user
# is already in the `dialout` group, which is all it takes. No root required.
[Unit]
Description=Smart Bartender machine service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SmartBartender/pi
ExecStart=/home/pi/SmartBartender/pi/.venv/bin/python -m app.main --arduino --config config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

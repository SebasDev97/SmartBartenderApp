# A template, not a unit file: @USER@ and @DIR@ are filled in at install time. Run from the
# pi/ folder on the Pi, as the user the service should run as (not after `sudo -i`):
#
#   sed -e "s|@USER@|$USER|g" -e "s|@DIR@|$PWD|g" bartender.service \
#     | sudo tee /etc/systemd/system/bartender.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bartender
#   journalctl -u bartender -f
#
# User= needs read/write on the Arduino's serial port: on Raspberry Pi OS the user created
# by the imager is already in the `dialout` group, which is all it takes. No root required.
[Unit]
Description=Smart Bartender machine service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python -m app.main --arduino --config config.yaml
# The Arduino sketch has no watchdog: after any stop — a crash included — switch every relay
# off from a fresh process. The leading '-' keeps a missing board from failing the unit.
ExecStopPost=-@DIR@/.venv/bin/python -m app.safe_off --config config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
